# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA suba o .env real pro Git.

# String de conexão do MongoDB Atlas (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/dekap-erp

# Chave secreta para assinar os tokens JWT - troque por algo aleatório e longo
JWT_SECRET=troque-esta-chave-por-algo-bem-aleatorio-e-secreto

PORT=3001

# Chave separada para criptografar a senha do certificado A1 em repouso.
# Se omitida, o sistema usa JWT_SECRET como fallback. Em produção, use uma chave longa e exclusiva.
CONFIG_SECRET=troque-por-uma-chave-longa-e-exclusiva-para-configuracoes

# Senha usada somente ao criar usuários de HOMOLOGAÇÃO com npm run seed.
# Defina uma senha temporária própria antes de rodar o seed.
SEED_PASSWORD=troque-por-uma-senha-temporaria-segura
